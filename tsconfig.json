{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": "src",
    "types": ["node"],
    "skipLibCheck": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
